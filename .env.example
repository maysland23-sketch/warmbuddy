DEEPSEEK_API_KEY=your-api-key-here
PORT=3000
# Server-only shared credential. Set the same random value in Vercel and Render.
RENDER_PROXY_SECRET=
# Vercel only: fixed Render upstream origin.
RENDER_ORIGIN=https://warmbuddy.onrender.com
# Render only: canonical browser entry and notification click target.
APP_PUBLIC_ORIGIN=https://warmbuddy.vercel.app
# VAPID keys for Web Push notifications (generate: npx web-push generate-vapid-keys)
# If left empty, the server auto-generates new keys on each restart
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:warmbuddy@example.com
# ntfy backend notifications (leave NTFY_TOPIC empty to disable)
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_CLICK_BASE_URL=https://warmbuddy.vercel.app
# Weather API key (optional — free Open-Meteo API used if not set)
WEATHER_API_KEY=
# Search API key (optional — free DuckDuckGo API used if not set)
SEARCH_API_KEY=
# User timezone offset in minutes (default 480 = UTC+8). Frontend auto-syncs on each config push.
USER_TIMEZONE_OFFSET=480
# Daily limits for proactive triggers (per project, persisted in Supabase)
MAX_DAILY_WAKE=10
MAX_DAILY_DESIRE=5
MAX_DAILY_EMAILS=2
# Outbound HTTPS proxy for blocked APIs like OpenRouter (e.g. http://127.0.0.1:7897)
HTTPS_PROXY=
# Supabase — persistent project configs (replaces ephemeral Render filesystem)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
# Android/Termux Agent Gateway for the fixed Claude Code test project
AGENT_GATEWAY_URL=https://agent.maysneverland.com
AGENT_GATEWAY_TOKEN=
AGENT_GATEWAY_TIMEOUT_MS=120000
AGENT_GATEWAY_PROJECT_ID=warmbuddy-test
